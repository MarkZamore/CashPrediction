<?xml version="1.0" encoding="UTF-8"?>
<!-- Обязательный аудит настоящих документов репозитория; отсутствие документа является ошибкой. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ru.cashprediction</groupId>
    <artifactId>cashprediction-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>cashprediction-repository-doc-audits</artifactId>
  <name>CashPrediction Repository Document Audits</name>
  <properties>
    <!-- Модуль только тестовый, его пустой jar не устанавливается и не публикуется. -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><skipIfEmpty>true</skipIfEmpty></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <systemPropertyVariables>
            <!-- Корень определяется от модуля, а не от cwd или наличия папки .git. -->
            <repository.basedir>${project.basedir}/..</repository.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
