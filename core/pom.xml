<?xml version="1.0" encoding="UTF-8"?>
<!--
  Модуль core: всё, что не зависит от UI-библиотек.
  Здесь живут доменная модель, движок прогноза, чтение/запись Markdown-файлов CashMemory,
  мини-JSON, модель снимка сессии и три хранилища снимков (реестр, XML, серверный Markdown).
  Модуль требует только java.prefs (реестр Windows) и java.xml (XML-снимок).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ru.cashprediction</groupId>
    <artifactId>cashprediction-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>cashprediction-core</artifactId>
  <name>CashPrediction Core</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Стандартные шаблоны surefire плюс *IT: интеграционный тест реестра Windows
               (RegistrySessionStoreIT) должен выполняться при каждой сборке. На не-Windows он пропускает себя сам. -->
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
