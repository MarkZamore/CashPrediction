today 2026-09-13
key Esc
sample
select r1@2026-10-05
menu edit.skip
dump skipped
key Ctrl+Z
dump undo-skip
key Ctrl+Y
dump redo-skip
menu edit.reset
dump reset-event
key Ctrl+Z
dump undo-reset
menu edit.planSettings
fill last cushion="60000"
ok last
dump settings-changed
key Ctrl+Z
dump undo-settings
key Ctrl+Shift+Z
dump redo-settings
